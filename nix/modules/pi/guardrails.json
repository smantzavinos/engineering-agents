{
  "version": "0.17.0",
  "enabled": true,
  "applyBuiltinDefaults": true,
  "onboarding": {
    "completed": true,
    "completedAt": "2026-05-05T00:00:00.000Z",
    "version": "0.17.0"
  },
  "features": {
    "policies": true,
    "permissionGate": true,
    "pathAccess": true
  },
  "pathAccess": {
    "mode": "ask",
    "allowedPaths": [
      { "kind": "file", "path": "/dev/null" }
    ]
  },
  "policies": {
    "rules": [
      {
        "id": "secret-files",
        "description": "Files containing secrets",
        "patterns": [
          { "pattern": ".env" },
          { "pattern": ".env.*" },
          { "pattern": ".env.local" },
          { "pattern": ".env.production" },
          { "pattern": ".env.prod" },
          { "pattern": ".dev.vars" }
        ],
        "allowedPatterns": [
          { "pattern": ".env.example" },
          { "pattern": ".env.sample" },
          { "pattern": ".env.test" },
          { "pattern": "*.example.env" },
          { "pattern": "*.sample.env" },
          { "pattern": "*.test.env" }
        ],
        "protection": "noAccess",
        "onlyIfExists": true
      }
    ]
  },
  "permissionGate": {
    "patterns": [
      { "pattern": "rm -rf", "description": "recursive force delete" },
      {
        "pattern": "git push (?:\\+[^\\s]+|.*(?:-f\\b|--force(?!-with-lease)|--force-with-lease|\\s\\+[^\\s]+))",
        "regex": true,
        "description": "Git force push"
      }
    ],
    "autoDenyPatterns": [
      { "pattern": "rm -rf", "description": "recursive force delete" },
      {
        "pattern": "git push (?:\\+[^\\s]+|.*(?:-f\\b|--force(?!-with-lease)|--force-with-lease|\\s\\+[^\\s]+))",
        "regex": true,
        "description": "Git force push"
      }
    ],
    "requireConfirmation": true
  }
}
